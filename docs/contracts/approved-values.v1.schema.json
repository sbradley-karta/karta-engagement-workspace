{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karta.example/contracts/approved-values.v1.schema.json",
  "title": "Karta Weekly Status approved values, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engagement",
    "period",
    "as_of",
    "milestones",
    "assessments",
    "overall",
    "accomplishments",
    "planned_activities",
    "raid",
    "source_gaps",
    "sources",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engagement_id",
        "client",
        "project_name"
      ],
      "properties": {
        "engagement_id": {
          "type": "string",
          "minLength": 1
        },
        "client": {
          "type": "string",
          "minLength": 1
        },
        "project_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "label"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "project_managers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "completed",
          "original_date",
          "new_date",
          "status",
          "variance_days",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "completed": {
            "type": "boolean"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "original_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "new_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "status": {
            "enum": [
              "Complete",
              "On Track",
              "At Risk",
              "Off Track",
              "Unknown"
            ]
          },
          "variance_days": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/source_ref"
          }
        }
      }
    },
    "assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_schedule",
        "resources",
        "data"
      ],
      "properties": {
        "scope_schedule": {
          "$ref": "#/$defs/assessment"
        },
        "resources": {
          "$ref": "#/$defs/assessment"
        },
        "data": {
          "$ref": "#/$defs/assessment"
        }
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/assessment_status"
        },
        "derivation": {
          "const": "worst_of"
        }
      }
    },
    "accomplishments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "planned_activities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "raid": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "description"
        ],
        "properties": {
          "type": {
            "enum": [
              "Risk",
              "Assumption",
              "Issue",
              "Dependency"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/source_ref"
          },
          "priority": {
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "mitigation": {
            "type": "string",
            "description": "Mitigation plan and next step, as shown on the status slide."
          }
        }
      }
    },
    "source_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "description"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system",
          "retrieved_at"
        ],
        "properties": {
          "system": {
            "enum": [
              "asana",
              "sharepoint",
              "granola",
              "harvest",
              "outlook",
              "engagement_record",
              "reviewer"
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "locator": {
            "type": "string"
          },
          "coverage": {
            "type": "string"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_name",
        "reviewer_email",
        "approved_at",
        "version"
      ],
      "properties": {
        "reviewer_name": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_email": {
          "type": "string",
          "format": "email"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "correction_capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_drafted_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewer_changed_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model_recommended_assessments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope_schedule": {
              "$ref": "#/$defs/assessment_status"
            },
            "resources": {
              "$ref": "#/$defs/assessment_status"
            },
            "data": {
              "$ref": "#/$defs/assessment_status"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "assessment_status": {
      "enum": [
        "Green",
        "Yellow",
        "Red",
        "Unknown",
        "Not assessed"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/assessment_status"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "id"
      ],
      "properties": {
        "system": {
          "enum": [
            "asana",
            "sharepoint",
            "granola",
            "harvest",
            "outlook",
            "engagement_record",
            "reviewer"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
