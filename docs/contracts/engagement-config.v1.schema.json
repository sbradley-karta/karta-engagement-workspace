{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karta.example/contracts/engagement-config.v1.schema.json",
  "title": "Karta engagement configuration, version 1.1",
  "description": "Resolves the engagement boundary for one site: identifiers, source locations, methodology phases with dates, templates, capabilities with readiness, and roles. Client facts never appear here beyond names and identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engagement_id",
    "client",
    "project_name",
    "stages",
    "sources",
    "templates",
    "capabilities",
    "roles"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "engagement_id": {
      "type": "string",
      "minLength": 1
    },
    "client": {
      "type": "string",
      "minLength": 1
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asana",
        "sharepoint"
      ],
      "properties": {
        "asana": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workspace_gid",
            "project_gid",
            "milestone_section_names"
          ],
          "properties": {
            "workspace_gid": {
              "type": "string"
            },
            "project_gid": {
              "type": "string"
            },
            "milestone_section_names": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "milestone_resource_subtype": {
              "type": "string",
              "description": "Optional. Filter on Asana resource_subtype, e.g. milestone."
            }
          }
        },
        "sharepoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "drive_id",
            "status_folder_item_id",
            "status_folder_web_url",
            "deck_filename_pattern"
          ],
          "properties": {
            "drive_id": {
              "type": "string"
            },
            "status_folder_item_id": {
              "type": "string"
            },
            "status_folder_web_url": {
              "type": "string"
            },
            "deck_filename_pattern": {
              "type": "string",
              "description": "Python format string, e.g. KCG_Status {client} {m}-{d}-{yyyy}.pptx"
            },
            "raid_log_item_id": {
              "type": "string"
            },
            "design_document_item_id": {
              "type": "string"
            }
          }
        },
        "granola": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "folder": {
              "type": "string"
            }
          }
        },
        "harvest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_deck_template_version"
      ],
      "properties": {
        "status_deck_template_version": {
          "type": "string"
        },
        "client_logo_item_id": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "readiness",
          "owner",
          "stages"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "readiness": {
            "enum": [
              "Experimental",
              "Piloted",
              "Standard",
              "Restricted"
            ]
          },
          "owner": {
            "type": "string"
          },
          "stages": {
            "type": "array",
            "items": {
              "enum": [
                "planning",
                "foundations",
                "build",
                "test",
                "train",
                "deploy",
                "support"
              ]
            }
          },
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "live": {
            "type": "boolean"
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewers",
        "members"
      ],
      "properties": {
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "email"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email"
          }
        },
        "engagement_lead": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drafts_days": {
          "type": "integer"
        },
        "conversations_days": {
          "type": "integer"
        },
        "generated_files_days": {
          "type": "integer"
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "start",
          "end",
          "kind"
        ],
        "properties": {
          "id": {
            "enum": [
              "planning",
              "foundations",
              "build",
              "test",
              "train",
              "deploy",
              "support"
            ]
          },
          "name": {
            "enum": [
              "Project Planning",
              "Foundations",
              "Build",
              "Test",
              "Train",
              "Deploy",
              "Continuous Support"
            ]
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Null for an open-ended stage such as Continuous Support."
          },
          "kind": {
            "enum": [
              "stage",
              "parallel"
            ],
            "description": "parallel marks a workstream that overlaps other stages, such as Train."
          },
          "contracted": {
            "type": "boolean",
            "description": "False when the stage is not in the engagement's scope, for example Continuous Support."
          },
          "source": {
            "type": "string",
            "description": "Where the dates came from, such as the approved project plan."
          },
          "source_updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "stages_confirmed_at": {
      "type": "string",
      "format": "date",
      "description": "Date the engagement owner last confirmed the stage dates."
    },
    "objectives": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Delivery objective per stage id, shown in the Now panel."
    },
    "control_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "name",
          "due",
          "owner",
          "decision",
          "evidence"
        ],
        "properties": {
          "stage": {
            "enum": [
              "planning",
              "foundations",
              "build",
              "test",
              "train",
              "deploy",
              "support"
            ]
          },
          "name": {
            "type": "string"
          },
          "due": {
            "type": "string",
            "format": "date"
          },
          "owner": {
            "type": "string",
            "description": "Named person. A bracketed placeholder such as [Business reviewer] is shown as an attention item."
          },
          "decision": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item",
                "state"
              ],
              "properties": {
                "item": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "ok",
                    "warn",
                    "off"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "deliverables": {
      "type": "object",
      "description": "Per stage id: the stage's deliverables and their states.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "state"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "state": {
              "enum": [
                "Approved",
                "In progress",
                "Draft",
                "Missing",
                "Not started"
              ]
            }
          }
        }
      }
    }
  }
}
