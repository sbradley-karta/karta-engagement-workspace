{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karta.example/contracts/engagement-config.v1.schema.json",
  "title": "Karta engagement configuration, version 1.2",
  "description": "One document per engagement workspace, stored in the page database at engagements/this/config/current. Written by the setup screen and the Config area; read by every viewer of the page. Identifiers, links, dates and people only, never client facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client",
    "project_name",
    "owner",
    "stages",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "engagement_id": {
      "type": "string",
      "minLength": 1
    },
    "client": {
      "type": "string",
      "minLength": 1
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asana",
        "sharepoint"
      ],
      "properties": {
        "asana": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "project_url": {
              "type": "string",
              "description": "The link the owner pasted. The page derives project_gid from it."
            },
            "project_gid": {
              "type": "string"
            },
            "project_name": {
              "type": "string"
            },
            "verified": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "milestone_section_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "milestone_resource_subtype": {
              "type": "string"
            }
          }
        },
        "sharepoint": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "status_folder_web_url": {
              "type": "string",
              "description": "Browser address of the Status and Steer Co folder, not a sharing link."
            },
            "drive_id": {
              "type": "string"
            },
            "status_folder_item_id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "verified": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "granola": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "folder_name": {
              "type": "string"
            },
            "folder_id": {
              "type": "string"
            },
            "note_count": {
              "type": [
                "integer",
                "null"
              ]
            },
            "verified": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "harvest": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "project": {
              "type": "string",
              "description": "Project name or code as typed by the owner."
            },
            "project_id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "project_name": {
              "type": "string"
            },
            "client_name": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "verified": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_deck_template_version"
      ],
      "properties": {
        "status_deck_template_version": {
          "type": "string"
        },
        "client_logo_item_id": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "readiness",
          "owner",
          "stages"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "readiness": {
            "enum": [
              "Experimental",
              "Piloted",
              "Standard",
              "Restricted"
            ]
          },
          "owner": {
            "type": "string"
          },
          "stages": {
            "type": "array",
            "items": {
              "enum": [
                "planning",
                "foundations",
                "build",
                "test",
                "train",
                "deploy",
                "support"
              ]
            }
          },
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "live": {
            "type": "boolean"
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engagement_lead": {
          "type": "string"
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drafts_days": {
          "type": "integer"
        },
        "conversations_days": {
          "type": "integer"
        },
        "generated_files_days": {
          "type": "integer"
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "enum": [
              "planning",
              "foundations",
              "build",
              "test",
              "train",
              "deploy",
              "support"
            ]
          },
          "name": {
            "enum": [
              "Project Planning",
              "Foundations",
              "Build",
              "Test",
              "Train",
              "Deploy",
              "Continuous Support"
            ]
          },
          "start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Null until the owner sets dates."
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Null for an open-ended stage such as Continuous Support."
          },
          "kind": {
            "enum": [
              "stage",
              "parallel"
            ],
            "description": "parallel marks a workstream that overlaps other stages, such as Train."
          },
          "contracted": {
            "type": "boolean",
            "description": "False when the stage is not in the engagement's scope, for example Continuous Support."
          },
          "source": {
            "type": "string",
            "description": "Where the dates came from, such as the approved project plan."
          },
          "source_updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "stages_confirmed_at": {
      "type": "string",
      "format": "date",
      "description": "Date the engagement owner last confirmed the stage dates."
    },
    "objectives": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Delivery objective per stage id, shown in the Now panel."
    },
    "control_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "name",
          "due",
          "owner",
          "decision",
          "evidence"
        ],
        "properties": {
          "stage": {
            "enum": [
              "planning",
              "foundations",
              "build",
              "test",
              "train",
              "deploy",
              "support"
            ]
          },
          "name": {
            "type": "string"
          },
          "due": {
            "type": "string",
            "format": "date"
          },
          "owner": {
            "type": "string",
            "description": "Named person. A bracketed placeholder such as [Business reviewer] is shown as an attention item."
          },
          "decision": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item",
                "state"
              ],
              "properties": {
                "item": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "ok",
                    "warn",
                    "off"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "deliverables": {
      "type": "object",
      "description": "Per stage id: the stage's deliverables and their states.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "state"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "state": {
              "enum": [
                "Approved",
                "In progress",
                "Draft",
                "Missing",
                "Not started"
              ]
            }
          }
        }
      }
    },
    "owner": {
      "type": "object",
      "required": [
        "name",
        "email"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      },
      "description": "The initial engagement owner named at setup, usually the client success executive. The owner sets reviewers and members with the team."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string"
    }
  }
}
